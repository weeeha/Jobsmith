# Postgres connection string. For local development, docker-compose.yml
# (added in the next task) starts a Postgres you can point this at.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobsmith

# Session signing secret, at least 32 characters. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL this app is served from. Also used as the Better Auth base
# URL and trusted origin. Required for local development and self-hosting.
# On Vercel this can usually be left unset: Preview always derives it from
# Vercel's own system environment variables, and so does Production unless
# it is served from a custom domain (see the README).
APP_URL=http://localhost:3000

# Set to "true" to allow sign-up after the first account already exists.
# Defaults to false: only the first account can sign up until you flip this.
ALLOW_SIGNUP=false

# Required before a first-run instance reachable from the internet is
# deployed: without it, a production deployment refuses first-run setup
# entirely instead of letting a stranger claim the instance (see the
# README's First run section). At least 16 characters when set. Not
# required for local development. Generate with:
#   openssl rand -base64 24
# SETUP_TOKEN=

# Sign-in attempts allowed per minute per client. Leave unset for the default
# of 5. The end-to-end suite sets a high value, because all of its browsers
# log in from the same address.
# AUTH_SIGNIN_MAX_PER_MINUTE=5

# AI (optional). Jobsmith works without it: intake then asks for the company
# and role. AI_PROVIDER turns it on:
#   gateway   - Vercel AI Gateway; every call asks for zero data retention
#   anthropic - the Anthropic API directly
#   fake      - the test suite's stand-in; never sends text anywhere
# AI_PROVIDER=
# Needed for gateway, except on Vercel, where the project's OIDC token is used.
# AI_GATEWAY_API_KEY=
# Needed for anthropic.
# ANTHROPIC_API_KEY=
# Optional. Defaults: anthropic/claude-haiku-4.5 (gateway), claude-haiku-4-5-20251001 (anthropic).
# AI_MODEL=

# Prep (Milestone 6) needs no new variables.

# Speech provider (Prep voice). Unset means off: the player speaks through the
# browser's own voices and no text is sent to a provider.
#   openai_compatible - any server with /v1/audio/speech (a local Qwen3-TTS, for one)
#   gemini | elevenlabs | fake (silent clips, for the test suite)
# TTS_PROVIDER=
# TTS_MODEL=
# Needed for openai_compatible. TTS_API_KEY only if that server wants one.
# TTS_BASE_URL=
# TTS_API_KEY=
# Needed for gemini and elevenlabs (elevenlabs also needs TTS_MODEL).
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# Read by `jobsmith audio` on your own computer, not by the app: the key for the
# speech server named by --tts-url.
# JOBSMITH_TTS_API_KEY=

# Audio storage (Prep voice). Where generated clips and recordings are kept.
#   local       - files under STORAGE_LOCAL_DIR; the default; refused on Vercel
#   memory      - in the server process; tests only, refused in production
#   s3          - any S3-compatible bucket (AWS, R2, MinIO)
#   vercel_blob - a private Vercel Blob store
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.data/storage
# Needed for s3. S3_ENDPOINT is for non-AWS stores; S3_FORCE_PATH_STYLE=true for MinIO.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# Needed for vercel_blob. The store must be private.
# BLOB_READ_WRITE_TOKEN=
# Live driver tests (tests/integration/storage-live.test.ts) run only with:
# JOBSMITH_LIVE_STORAGE=1

# Script-only variables below: read by scripts/*.ts, never by the app itself.

# Required to confirm `pnpm reset-db` (which still refuses a non-local host).
# ALLOW_DB_RESET=true

# The password `pnpm seed` gives its demo user, instead of generating and printing a random one.
# SEED_PASSWORD=
