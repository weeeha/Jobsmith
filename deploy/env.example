# Copy to `.env` next to compose.yaml and fill in every value.
# The file holds secrets: keep it at mode 600 (`chmod 600 .env`).
# DATABASE_URL is not set here: compose builds it from POSTGRES_PASSWORD.
# Use a password of letters and digits only, since it goes into a URL.

# Compose and Caddy
POSTGRES_PASSWORD=
JOBSMITH_DOMAIN=jobs.example.com
ACME_EMAIL=you@example.com
JOBSMITH_TAG=1

# The app
APP_URL=https://jobs.example.com
# At least 32 characters, for example `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# At least 16 characters; it opens /setup for the first account
SETUP_TOKEN=

# Optional
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# STORAGE_PROVIDER=local
